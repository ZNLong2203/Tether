# ─────────────────────────────────────────────────────────────
#  Local-only working files: not part of the published repository.
# ─────────────────────────────────────────────────────────────
/private/
*.private.md

# Notes for local coding agents
/AGENTS.md
/CLAUDE.md

# ─── Secrets / QNX licences ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
.qnx/
qnxsdp-env.local.sh

# ─── Build output ────────────────────────────────────────────
/build/
/build-*/
/out/
*.o
*.a
*.so
*.d
compile_commands.json

# ─── QEMU images generated by mkqnximage ─────────────────────
# The whole working folder: besides images it holds generated private keys
# (ssh host keys, qtd_private_key.pem). Tracked inputs live in qnx/image/.
/target/
*.img
*.ifs
!target/**/*.build

# ─── Python / Node tooling ───────────────────────────────────
__pycache__/
*.pyc
.venv/
node_modules/
.pytest_cache/

# ─── Editors / OS ────────────────────────────────────────────
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.log

# codelab example build output
/docs/codelab/markdown/*/src/out/

# video build output (frames are large)
/build-video/
