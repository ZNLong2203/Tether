# ─────────────────────────────────────────────────────────────
#  Private — never pushed. The repo goes public; these do not.
#  (strategy notes, submission drafts, demo script, video sources)
# ─────────────────────────────────────────────────────────────
/private/
*.private.md

# ─── Secrets / QNX licences ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
.qnx/
qnxsdp-env.local.sh

# ─── Build output ────────────────────────────────────────────
/build/
/build-*/
/out/
*.o
*.a
*.so
*.d
compile_commands.json

# ─── QEMU images generated by mkqnximage ─────────────────────
/target/qemu/output/
*.img
*.ifs
!target/**/*.build

# ─── Python / Node tooling ───────────────────────────────────
__pycache__/
*.pyc
.venv/
node_modules/
.pytest_cache/

# ─── Editors / OS ────────────────────────────────────────────
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.log
